FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      NaCl.dispersed;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1.20047668452848E-14;

boundaryField
{
    walls
    {
        type            zeroGradient;
    }

    empties
    {
        type            empty;
    }
}
